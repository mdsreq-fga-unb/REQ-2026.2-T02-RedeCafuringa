# Copie para app/.env.local (ignorado pelo git): ./scripts/dev.sh setup faz isso por você.
#
# ATENÇÃO: tudo com prefixo VITE_ vai para o bundle e é PÚBLICO.
# Nunca coloque senha, token ou chave privada aqui.

# URL base da API, com o prefixo /api/v1, sem barra final. Vazio = mesma origem.
VITE_API_URL=http://localhost:3000/api/v1

# Login falso, só para desenvolvimento, enquanto o login real não está integrado.
# Deve ser "true" ou "false". Em produção deixe "false".
VITE_USE_MOCK_AUTH=true
