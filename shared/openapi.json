          },
          "401": {
            "description": "Sem token ou token inválido",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Dados do usuário autenticado",
        "tags": [
          "auth"
        ]
      }
    }
  },
  "info": {
    "title": "Rede Cafuringa API",
    "description": "API REST da plataforma **Rede Cafuringa**.\n\n**Autenticação.** `POST /auth/login` troca CPF e senha por um JWT. Envie-o em `Authorization: Bearer <token>`. Toda rota exige login, exceto as marcadas como públicas (negação por padrão).\n\n**Rastreabilidade.** Envie `x-request-id` (1 a 128 caracteres de `A-Za-z0-9._-`). A API devolve o mesmo id no cabeçalho da resposta e nos logs; sem o cabeçalho, ou com valor inválido, gera um UUID.\n\n**Erros.** Todo erro tem o corpo `ErrorResponse` (`statusCode`, `message`, `error`). Nas falhas de validação (400), `message` é uma lista.\n\n**Limites.** Rotas de login e cadastro têm limite estrito de tentativas por IP; ao exceder, a resposta é 429 com `Retry-After` (segundos).\n\n**Dados pessoais.** Respostas nunca trazem hash de senha nem o CPF completo (vem mascarado).\n\n**Versão do contrato.** SemVer, em `info.version`. Veja docs/shared/contratos.md.",
    "version": "0.1.0",
    "contact": {
      "name": "Equipe Bytelab",
      "url": "https://github.com/mdsreq-fga-unb/REQ-2026.2-T02-RedeCafuringa",
      "email": ""
    }
  },
  "tags": [
    {
      "name": "auth",
      "description": "Login e dados da sessão (RN08)"
    },
    {
      "name": "users",
      "description": "Cadastro de usuários (RN02, RN15)"
    },
    {
      "name": "health",
      "description": "Saúde do serviço, para o Docker e monitores externos"
    }
  ],
  "servers": [
    {
      "url": "http://localhost:3000",
      "description": "Desenvolvimento local"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http",
        "description": "JWT obtido em POST /auth/login"
      }
    },
    "schemas": {
      "CreateConsumerDto": {
        "type": "object",
        "properties": {
          "nome": {
            "type": "string",
            "example": "Maria das Graças"
          },
          "cpf": {
            "type": "string",
            "example": "529.982.247-25",
            "description": "Com ou sem máscara"
          },
          "telefone": {
            "type": "string",
            "example": "61999990000",
            "description": "DDD + número"
          },
          "email": {
            "type": "string",
            "example": "maria@exemplo.com"
          },
          "dataNascimento": {
            "type": "string",
            "example": "1990-05-10",
            "description": "AAAA-MM-DD"
          },
          "senha": {
            "type": "string",
            "example": "SenhaForte123",
            "description": "8 a 128 caracteres, com pelo menos uma letra e um número"
          }
        },
        "required": [
          "nome",
          "cpf",
          "telefone",
          "email",
          "dataNascimento",
          "senha"
        ]
      },
      "UserResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "nome": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "telefone": {
            "type": "string"
          },
          "perfil": {
            "type": "string",
            "enum": [
              "CONSUMIDOR",
              "PRODUTOR",
              "ADMINISTRADOR"
            ]
          },
          "cpf": {
            "type": "string",
            "example": "***.982.247-**",
            "description": "CPF mascarado"
          }
        },
        "required": [
          "id",
          "nome",
          "email",
          "telefone",
          "perfil",
          "cpf"
        ]
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "statusCode": {
            "type": "number",
            "example": 400,
            "description": "Mesmo valor do status HTTP"
          },
          "message": {
            "description": "Texto do erro. Nas falhas de validação (400) é uma lista, uma mensagem por campo inválido.",
            "oneOf": [
              {
                "type": "string",
                "example": "Unauthorized"
              },
              {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "example": [
                  "CPF inválido",
                  "Senha é obrigatória"
                ]
              }
            ]
          },
          "error": {
            "type": "string",
            "example": "Bad Request",
            "description": "Nome do status HTTP"
          }
        },
        "required": [
          "statusCode",
          "message",
          "error"
        ]
      },
      "LoginDto": {
        "type": "object",
        "properties": {
          "cpf": {
            "type": "string",
            "example": "529.982.247-25",
            "description": "Com ou sem máscara"
          },
          "senha": {
            "type": "string",
            "example": "SenhaForte123"
          }
        },
        "required": [
          "cpf",
          "senha"
        ]
      },
      "LoginResponse": {
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string",
            "description": "JWT a enviar em Authorization: Bearer <token>"
          },
          "tokenType": {
            "type": "string",
            "example": "Bearer"
          },
          "expiresIn": {
            "type": "number",
            "example": 900,
            "description": "Validade do token, em segundos"
          },
          "usuario": {
            "$ref": "#/components/schemas/UserResponse"
          }
        },
        "required": [
          "accessToken",
          "tokenType",
          "expiresIn",
          "usuario"
        ]
      }
    }
  }
}
