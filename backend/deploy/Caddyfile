# Caddy emite e renova o certificado TLS automaticamente (Let's Encrypt)
# e redireciona HTTP -> HTTPS por padrão (RNF10).
{
	admin off

	servers {
		timeouts {
			read_body 10s
			read_body_idle 30s
			read_header 10s
			write 30s
			write_idle 30s
			idle 120s
		}
	}
}

# O www só redireciona para o domínio principal (também com TLS próprio).
www.{$APP_DOMAIN} {
	redir https://{$APP_DOMAIN}{uri} permanent
}

# App e API no mesmo domínio: /api/* vai para a API e o resto para o app.
# Assim o app chama /api/v1 na própria origem, sem CORS entre domínios.
{$APP_DOMAIN} {
	encode zstd gzip

	# Vale para o site inteiro. Os demais cabeçalhos ficam por rota: os do app
	# (CSP e política de permissões) vêm do nginx dele e não podem ser sobrescritos.
	header Strict-Transport-Security "max-age=31536000"

	# JSON nunca passa de 1 MB. Exceções são os envios de foto:
	# - foto de perfil (HU12/RF12): a API aceita até 5 MB;
	# - cadastro de produto (HU15): galeria de até 10 fotos de 5 MB cada
	#   (PHOTO_GALLERY_POLICIES.produto; o valor sai de maxRequestBytes());
	# - cadastro de experiência (HU21): mesma galeria (PHOTO_GALLERY_POLICIES.experiencia).
	# A margem cobre o envelope multipart. O app reduz as fotos antes de enviar,
	# então o normal é ficar em centenas de KB (o read_body de 10s acima conta).
	# Nova galeria (ex.: propriedade) = nova rota aqui, com o valor da política dela.
	@photoUpload path /api/v1/producers/me/photo
	request_body @photoUpload {
		max_size 6MB
	}
	@productUpload {
		method POST
		path /api/v1/products
	}
	request_body @productUpload {
		max_size 51MB
	}
	@experienceUpload {
		method POST
		path /api/v1/experiences
	}
	request_body @experienceUpload {
		max_size 51MB
	}
	@jsonOnly {
		not path /api/v1/producers/me/photo
		not {
			method POST
			path /api/v1/products
		}
		not {
			method POST
			path /api/v1/experiences
		}
	}
	request_body @jsonOnly {
		max_size 1MB
	}

	log {
		output stdout
		format json
	}

	# Métricas são internas. O acesso público fica bloqueado; o scrape deve
	# ser feito na rede interna (ou por um sidecar autorizado).
	@metrics path /api/v1/metrics

	# Swagger UI (só existe se a API subir com SWAGGER_ENABLED=true). Sempre atrás
	# de basic auth. O docker-compose.prod.yml define, quando o hash não é informado, um
	# hash de senha descartada: ninguém entra (falha fechada).
	@swagger path /api/v1/docs /api/v1/docs/*

	# `handle` vem antes de `respond` na ordem do Caddy: as regras da API ficam
	# dentro deste bloco, senão o 404 das métricas nunca seria aplicado.
	handle /api/* {
		header {
			X-Content-Type-Options "nosniff"
			X-Frame-Options "DENY"
			Referrer-Policy "strict-origin-when-cross-origin"
			Permissions-Policy "camera=(), microphone=(), geolocation=(self)"
		}

		respond @metrics 404

		basic_auth @swagger {
			{$SWAGGER_USER} {$SWAGGER_PASSWORD_HASH}
		}

		reverse_proxy api:3000 {
			health_uri /api/v1/health/ready
			health_interval 15s
			health_timeout 3s
		}
	}

	# Todo o resto é o app (PWA) servido pelo nginx do serviço web.
	handle {
		reverse_proxy web:8080
	}
}
