# Domínio público da API (Caddy emite o TLS para ele)
API_DOMAIN=api.exemplo.com.br

# Origem do front (Cloudflare Pages). Em produção, apenas HTTPS.
CORS_ORIGINS=https://rede-cafuringa.pages.dev

# Root do MongoDB: usado somente para administração e backup.
MONGO_ROOT_USER=cafuringa_root
MONGO_ROOT_PASSWORD=troque-esta-senha-root

# Usuário da aplicação: readWrite apenas no banco abaixo.
MONGO_APP_USER=cafuringa_app
MONGO_APP_PASSWORD=troque-esta-senha-app
MONGO_DB=cafuringa

# Ajuste conforme a VM: 0.25 para 1 GB, 0.5 para 2 GB, 1–2 para 8 GB.
MONGO_WIREDTIGER_CACHE_GB=0.5
MONGO_MEM_LIMIT=1g
API_MEM_LIMIT=512m
CADDY_MEM_LIMIT=128m

# Logs e rate limit
LOG_LEVEL=info
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# Protege /api/v1/metrics se alguém acessar a API por dentro da rede.
# Gere com: openssl rand -hex 32
METRICS_TOKEN=troque-por-um-token-de-32-bytes

# Swagger UI (/api/v1/docs) no ambiente de dev. Desligado por padrão.
# Para ligar: SWAGGER_ENABLED=true e defina o hash do basic auth do Caddy.
# Gere o hash com: docker run --rm caddy:2.11.7-alpine caddy hash-password
# No .env, coloque o hash entre aspas simples para o Compose não interpretar os "$":
#   SWAGGER_PASSWORD_HASH='$2a$14$...'
SWAGGER_ENABLED=false
SWAGGER_USER=docs
# SWAGGER_PASSWORD_HASH='$2a$14$troque'

# Autenticação (JWT) e proteção do CPF. Gere cada um com: openssl rand -hex 32
# JWT_SECRET e PII_HMAC_SECRET devem ser diferentes.
# ATENÇÃO: PII_HMAC_SECRET e PII_ENCRYPTION_KEY não podem ser trocados depois
# do primeiro cadastro sem migração: os CPFs gravados ficariam inacessíveis.
# Guarde-os junto da chave de backup, fora do servidor.
JWT_SECRET=troque-por-openssl-rand-hex-32
JWT_EXPIRES_IN=900
AUTH_THROTTLE_LIMIT=5
PII_HMAC_SECRET=troque-por-openssl-rand-hex-32
PII_ENCRYPTION_KEY=troque-por-openssl-rand-hex-32

# Primeiro administrador (HU03). Cria a conta na subida, se o e-mail ainda não
# existir (idempotente). Os dois juntos, senha com 8+ caracteres, letra e número.
# Depois de entrar, cadastre os demais administradores pela API e apague a senha daqui.
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_SENHA=

# Recuperação de acesso (HU10). Obrigatórias em produção.
# Origem do front em HTTPS, sem caminho: os links de redefinição apontam para ela.
APP_PUBLIC_URL=https://rede-cafuringa.pages.dev
# SMTP gratuito (ex.: Brevo, 300 e-mails/dia). A porta 587 exige STARTTLS; 465 usa TLS direto.
MAIL_FROM=Rede Cafuringa <nao-responda@exemplo.com.br>
SMTP_HOST=smtp-relay.exemplo.com
SMTP_PORT=587
SMTP_USER=troque-pelo-usuario-smtp
SMTP_PASSWORD=troque-pela-senha-smtp
# Validade do link (minutos) e intervalo mínimo entre pedidos da mesma conta (segundos).
PASSWORD_RESET_TTL_MINUTES=30
PASSWORD_RESET_COOLDOWN_SECONDS=60
# Esperas (ms) entre os reenvios após falha do SMTP. Alerta: cafuringa_mail_delivery_failures_total.
MAIL_RETRY_DELAYS_MS=2000,10000

# Backup (usado pelo script deploy/backup/backup.sh no host)
MONGO_BACKUP_DIR=/var/backups/cafuringa
BACKUP_RETENTION_DAYS=7
# Opcional: destinatário age para criptografar o arquivo antes do upload.
# BACKUP_AGE_RECIPIENT=age1...
# Opcional: bucket OCI Object Storage (privado e versionado).
# BACKUP_OCI_BUCKET=rede-cafuringa-backups
