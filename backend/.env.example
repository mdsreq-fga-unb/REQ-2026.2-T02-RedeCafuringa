NODE_ENV=development
PORT=3000

# Dev: URI pronta. Em produção, prefira os componentes abaixo para que senhas
# com @, :, /, ? ou # sejam codificadas corretamente.
MONGODB_URI=mongodb://localhost:27017/cafuringa
# MONGODB_HOST=mongo:27017
# MONGODB_DB=cafuringa
# MONGODB_USER=cafuringa_app
# MONGODB_PASSWORD=troque-esta-senha
# MONGODB_AUTH_SOURCE=cafuringa

# Origens separadas por vírgula (front React/PWA)
CORS_ORIGINS=http://localhost:5173

# Atrás de um proxy confiável (Caddy), use 1. Em dev direto, 0.
TRUST_PROXY=0
LOG_LEVEL=debug

# Rate limit global: janela em segundos e requisições por janela.
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# Opcional. Em produção, /api/v1/metrics exige este token (mínimo 16 chars)
# e o Caddy bloqueia o endpoint para a internet.
METRICS_TOKEN=
